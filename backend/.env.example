DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=techshop_db
DB_PORT=3306


PORT=3000

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FASTAPI_URL=http://localhost:8000
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_VECTOR_DIMENSION=512

VIETQR_BANK_ID=MB
VIETQR_BANK_NAME=MBBank
VIETQR_ACCOUNT_NO=your_account_number
VIETQR_ACCOUNT_NAME=your_account_name
VIETQR_TEMPLATE=compact2



NODE_ENV=development

# Coarse delivery estimate from the nearest showroom to the selected ward.
EXPRESS_DELIVERY_RADIUS_KM=15
EXPRESS_DELIVERY_FEE=0
STANDARD_SHIPPING_BASE_FEE=20000
STANDARD_SHIPPING_FEE_PER_KM=1500
STANDARD_SHIPPING_MIN_FEE=25000
STANDARD_SHIPPING_MAX_FEE=500000

# Nominatim-compatible geocoder; only ward and province names are queried.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=BleenTechGear/1.0
# Optional verified representative coordinates for wards the geocoder cannot resolve.
# Key by exact provinceId:wardId, e.g. {"<provinceId>:<wardId>":{"latitude":<lat>,"longitude":<lon>}}.
# SHIPPING_WARD_COORDINATES_JSON=
# Optional: set store locations as JSON with id, name, and address or latitude/longitude.
# SHIPPING_STORES_JSON=[{"id":"hanoi","name":"Showroom Cầu Giấy","address":"123 Cầu Giấy, Cầu Giấy, Hà Nội, Việt Nam"},{"id":"hcm","name":"Showroom Quận 10","address":"456 Cách Mạng Tháng Tám, Quận 10, Hồ Chí Minh, Việt Nam"}]
