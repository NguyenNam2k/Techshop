{
  "name": "techshop-api",
  "version": "1.0.0",
  "description": "Techshop Backend Authentication API with Node.js, Express, MySQL, bcrypt, and JWT",
  "main": "Backend/server.js",
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch Backend/server.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build:frontend": "npm --prefix Frontend install --include=dev && npm --prefix Frontend run build",
    "build:client": "npm --prefix Frontend install --include=dev && npm --prefix Frontend run build",
    "build:manager": "npm --prefix views/manager-app install --include=dev && npm --prefix views/manager-app run build",
    "frontend": "npm --prefix Frontend run dev",
    "client": "npm --prefix Frontend run dev",
    "kill:ports": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000,5000,5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "techshop",
    "express",
    "jwt",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
