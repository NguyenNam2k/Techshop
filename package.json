  "main": "backend/src/app.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "db:seed": "node backend/scripts/seed_mock.js",
    "db:clean": "node backend/scripts/clean_mock.js",
    "mock:seed": "node backend/scripts/seed_mock.js",
    "mock:clean": "node backend/scripts/clean_mock.js",
    "dev:mock": "node backend/scripts/mock_runner.js",
    "kill:ports": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000,5000,5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\""
  },
