# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (InnoDB Connection Pool)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=techshop_db
DB_PORT=3306

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary Storage Configuration (Tuỳ chọn cho Phương án Lưu Cloud)
# Nếu không điền, hệ thống sẽ tự động lưu ảnh vào máy cục bộ (/public/uploads/products)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
